{
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:doc": "turbo run build-doc",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"cov": "vitest run --coverage",
		"cs": "changeset",
		"css": "pnpm --filter ./libs/css",
		"knip": "knip",
		"nuke": "run-s nuke:pkgs nuke:root",
		"nuke:pkgs": "turbo run nuke",
		"nuke:root": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"sb": "turbo run sb",
		"test": "turbo run test",
		"tk": "pnpm --filter ./libs/toolkits",
		"typecheck": "tsc",
		"types": "pnpm --filter ./libs/types",
		"verify": "turbo run build check knip typecheck cov",
		"version": "changeset version && node scripts/update-version-tags.mjs",
		"w": "vitest",
		"website": "pnpm --filter ./apps/website"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@repobuddy/biome": "^2.3.1",
		"@repobuddy/vitest": "^2.1.2",
		"@types/react": "^19.2.18",
		"@vitest/coverage-v8": "^4.1.11",
		"husky": "^9.1.7",
		"pathe": "^2.0.3",
		"playwright": "latest",
		"rimraf": "~6.0.1",
		"turbo": "^2.10.12",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@tools/typescript": "workspace:^",
		"@types/node": "^26.4.1",
		"knip": "^6.33.0",
		"npm-run-all2": "^9.0.3"
	},
	"packageManager": "pnpm@11.1.3"
}
