{
	"name": "@just-web/toolkits",
	"version": "3.5.1",
	"description": "Toolkits for web applications",
	"homepage": "https://github.com/justland/just-web-foundation/tree/main/libs/toolkits",
	"repository": {
		"type": "git",
		"url": "https://github.com/justland/just-web-foundation.git",
		"directory": "libs/toolkits"
	},
	"license": "MIT",
	"author": "Unional <homawong@gmail.com>",
	"type": "module",
	"exports": {
		".": {
			"@just-web/toolkits-dev": "./src/index.ts",
			"types": [
				"./dist/index.d.ts",
				"./src/index.ts"
			],
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./index.js": null,
		"./*.js": {
			"@just-web/toolkits-dev": "./src/*.ts",
			"types": [
				"./dist/*.d.ts",
				"./src/*.ts"
			],
			"source": "./src/*.ts",
			"default": "./dist/*.js"
		},
		"./react": {
			"types": [
				"./dist/react.d.ts",
				"./src/react.ts"
			],
			"source": "./src/react.ts",
			"default": "./dist/react.js"
		},
		"./theme": {
			"types": [
				"./dist/theme.d.ts",
				"./src/theme.ts"
			],
			"source": "./src/theme.ts",
			"default": "./dist/theme.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"source": "./src/index.ts",
	"types": "./dist/index.d.cts",
	"files": [
		"dist",
		"src",
		"!**/*.{spec,test,unit,accept,integrate,system,stories}.*",
		"!**/*.mdx"
	],
	"scripts": {
		"build": "run-p build:* test:types",
		"build-doc": "storybook build -o ../../docs/toolkits",
		"build:code": "tsdown",
		"check:css": "tailwindcss -i .storybook/tailwind.css -o ./styles.storybook.css",
		"clean": "rimraf .turbo dist *.tsbuildinfo",
		"cov": "vitest run --coverage",
		"cov:w": "vitest --coverage",
		"nuke": "rimraf node_modules",
		"sb": "storybook dev -p 6206",
		"test": "vitest run",
		"test:types": "tsc --noEmit",
		"w": "vitest"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"csstype": "^3.2.3",
		"type-plus": "^7.6.2"
	},
	"devDependencies": {
		"@repobuddy/storybook": "^2.32.1",
		"@repobuddy/vitest": "^2.1.2",
		"@storybook-community/storybook-dark-mode": "^7.1.3",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/react-vite": "^10.5.10",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@tools/typescript": "workspace:^",
		"@types/react": "^19.2.18",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"dedent": "^1.7.2",
		"jotai": "^2.20.3",
		"npm-run-all2": "^9.0.3",
		"react": "catalog:",
		"react-aria-components": "^1.20.0",
		"react-dom": "catalog:",
		"rimraf": "^6.1.3",
		"storybook": "^10.5.10",
		"storybook-addon-code-editor": "^6.2.0",
		"storybook-addon-tag-badges": "^3.1.0",
		"storybook-addon-vis": "^4.2.4",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.18.4",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"zustand": "^5.0.15"
	}
}
